# The launchers and their manifest run as-is on every OS: a CRLF
# checkout (core.autocrlf on Windows) would break sh and the manifest parser.
packages/runtime/launcher/launch.sh text eol=lf
packages/runtime/launcher/launch.ps1 text eol=lf
packages/runtime/launcher/manifest.json text eol=lf
# The pinned release key (#424): the tests and the release preflight compare
# its exact bytes, and launch.ps1 reads release.pub.xml as-is.
packages/runtime/launcher/release.pub.pem text eol=lf
packages/runtime/launcher/release.pub.xml text eol=lf
# The vendored Maina Link protocol is pinned by sha256 (#589): its bytes must
# never change on checkout, so no end-of-line conversion applies to it.
packages/runtime/src/link/protocol/v1/** -text
