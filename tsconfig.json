{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun-types"],
    "paths": {
      "@mainahq/core": ["./packages/core/src/index.ts"],
      "@mainahq/mcp": ["./packages/mcp/src/index.ts"],
      "@mainahq/mcp/catalog": ["./packages/mcp/src/catalog.ts"]
    }
  }
}
