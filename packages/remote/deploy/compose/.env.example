# Copy to .env next to docker-compose.yml and fill in.

# ── The MCP service ──────────────────────────────────────────────────────
# Public origin (https unless loopback). Put your TLS terminator in front of
# the ingress and set this to its origin.
MAINA_REMOTE_ISSUER=http://localhost:8787
MAINA_REMOTE_OWNER=owner
# Required, 12+ characters: the owner signs in with it to approve clients.
MAINA_REMOTE_PASSWORD=
# The repository the MCP tools act on, mounted read-only.
MAINA_WORKSPACE=./workspace
# Where the ingress listens on the host.
MAINA_BIND=127.0.0.1
MAINA_PORT=8787

# ── The GitHub App (PR jobs) ─────────────────────────────────────────────
MAINA_GITHUB_APP_ID=
# PEM on one line, with \n for line breaks.
MAINA_GITHUB_APP_PRIVATE_KEY=
# GitHub Enterprise only, e.g. https://ghe.example.com/api/v3
MAINA_GITHUB_API_URL=

# ── Operator state, mounted read-only into $HOME/.maina ───────────────────
MAINA_POLICY_FILE=./policy.json
MAINA_MODEL_DIR=./models

# ── Egress ───────────────────────────────────────────────────────────────
# Exact hosts (optionally host:port, default 443) the install may reach.
# GitHub Enterprise: your GHE host instead. Anything added here is traffic
# leaving your network.
MAINA_EGRESS_ALLOW=github.com,api.github.com

# Image to run; `docker compose build` tags the local build with this name.
MAINA_IMAGE=maina-remote:local
