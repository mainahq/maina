---
import { HOME_NAV } from '../../data/landing';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const href = (h: string): string => (h.startsWith('/') ? `${base}${h}` : h);
---

<header class="nav">
  <div class="wrap flex items-center gap-6 py-3.5 max-sm:gap-2.5">
    <a class="wordmark" href="#top" aria-label="Maina home">
      <svg class="mark" aria-hidden="true"><use href="#mynah" /></svg>{HOME_NAV.brand}
    </a>
    <nav class="nav-links ml-auto flex gap-5 text-sm text-mute-ink max-md:hidden" aria-label="Primary">
      {HOME_NAV.links.map((l) => <a href={href(l.href)}>{l.label}</a>)}
    </nav>
    <button
      class="motion-toggle max-md:ml-auto"
      id="motion"
      type="button"
      aria-pressed="false"
      data-pause={HOME_NAV.motion.pause}
      data-play={HOME_NAV.motion.play}
    >{HOME_NAV.motion.pause}</button>
    <a class="btn btn-ghost text-[13px] max-md:hidden" href={HOME_NAV.star.href} rel="noopener" data-event="star_click">{HOME_NAV.star.label}</a>
    <a class="btn btn-primary max-sm:px-3.5 max-sm:text-[13px]" href={HOME_NAV.cta.href} data-event="cta_nav">{HOME_NAV.cta.label}</a>
  </div>
</header>
