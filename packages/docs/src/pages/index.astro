---
/**
 * `/` — the v1 landing page (#360), after the canonical prototype. Copy in
 * `src/data/landing.ts`; verdicts, counts and receipts in the generated
 * `src/data/landing-proofs.json`.
 */
import Mynah from '../components/home/Mynah.astro';
import Nav from '../components/home/Nav.astro';
import Hero from '../components/home/Hero.astro';
import GatePlayground from '../components/home/GatePlayground.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Agents from '../components/home/Agents.astro';
import TheBar from '../components/home/TheBar.astro';
import Proofs from '../components/home/Proofs.astro';
import PrReceipt from '../components/home/PrReceipt.astro';
import Comparison from '../components/home/Comparison.astro';
import Pricing from '../components/home/Pricing.astro';
import Faq from '../components/home/Faq.astro';
import Footer from '../components/home/Footer.astro';
import { FAQ, META } from '../data/landing';
import cliPackage from '../../../cli/package.json';
import '../styles/home.css';

// Fail the build if the CLI version isn't readable: JSON-LD with a made-up
// softwareVersion is worse than none, it poisons search indexes.
const cliVersion = (cliPackage as { version?: unknown }).version;
if (typeof cliVersion !== 'string' || cliVersion.trim() === '') {
  throw new Error('packages/cli/package.json must declare a non-empty version');
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Maina',
    description: META.description,
    url: META.url,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows (WSL)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    softwareVersion: cliVersion,
    author: { '@type': 'Person', name: 'Bikash Dash' },
    codeRepository: 'https://github.com/mainahq/maina',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{META.title}</title>
    <meta name="description" content={META.description} />
    <link rel="canonical" href={META.url} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={META.url} />
    <meta property="og:title" content={META.title} />
    <meta property="og:description" content={META.ogDescription} />
    {META.ogImage && <meta property="og:image" content={META.ogImage} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={META.title} />
    <meta name="twitter:description" content={META.ogDescription} />
    <meta name="theme-color" content="#141010" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Martian+Mono:wdth,wght@75..112.5,400..700&display=optional"
    />
    <script is:inline type="application/ld+json" set:html={jsonLdText} />
  </head>
  <body>
    <a class="skip" href="#gate">Skip to the demo</a>
    <Mynah />
    <Nav />
    <main id="top">
      <Hero />
      <GatePlayground />
      <HowItWorks />
      <Agents />
      <TheBar />
      <Proofs />
      <PrReceipt />
      <Comparison />
      <Pricing />
      <Faq />
    </main>
    <Footer />
    <script>
      import { initUi } from '../scripts/home/ui';
      import { initMotion } from '../scripts/home/motion';
      import { initWaitlist } from '../scripts/home/waitlist-form';
      initUi();
      initMotion();
      initWaitlist();
    </script>
  </body>
</html>
