      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mainahq/core": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
