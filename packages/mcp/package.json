{
  "name": "@mainahq/mcp",
  "version": "1.8.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Maina MCP server — Model Context Protocol bridge for AI host agents",
  "homepage": "https://mainahq.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mainahq/maina.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "keywords": [
    "maina",
    "mcp",
    "model-context-protocol",
    "verification",
    "ai-code-review"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
