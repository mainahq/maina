exports[`tool schemas match the snapshot: context 1`] = `
{
  "annotations": {
    "readOnlyHint": true,
  },
  "description": "Source snippets for explicit files or a free-text query plus their call-graph neighbourhood, within a token budget. Cheaper than reading whole files; reports the tokens saved.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "budgetTokens": {
        "description": "Token ceiling for the snippets. Defaults to 8000.",
        "maximum": 30000,
        "minimum": 1,
        "type": "integer",
      },
      "depth": {
        "description": "Hops of callees and callers to consider. Defaults to 1.",
        "maximum": 5,
        "minimum": 0,
        "type": "integer",
      },
      "files": {
        "description": "Files whose symbols are the targets: repo-relative, or absolute inside the root.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "query": {
        "description": "Free text: the best-matching symbols become the targets.",
        "type": "string",
      },
      "root": {
        "description": "Absolute path of the repository to act on. Defaults to the root the server resolves for itself, normally the repository it was started in.",
        "type": "string",
      },
    },
    "type": "object",
  },
  "name": "context",
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "data": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "naiveTokens": {
                "type": "number",
              },
              "omitted": {
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "savedTokens": {
                "type": "number",
              },
              "snippets": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "depth": {
                      "type": "number",
                    },
                    "endLine": {
                      "type": "number",
                    },
                    "id": {
                      "type": "string",
                    },
                    "kind": {
                      "type": "string",
                    },
                    "name": {
                      "type": "string",
                    },
                    "path": {
                      "type": "string",
                    },
                    "qualifiedName": {
                      "type": "string",
                    },
                    "reason": {
                      "enum": [
                        "target",
                        "callee",
                        "caller",
                      ],
                      "type": "string",
                    },
                    "startLine": {
                      "type": "number",
                    },
                    "text": {
                      "type": "string",
                    },
                    "tokens": {
                      "type": "number",
                    },
                  },
                  "required": [
                    "id",
                    "path",
                    "name",
                    "qualifiedName",
                    "kind",
                    "startLine",
                    "endLine",
                    "reason",
                    "depth",
                    "text",
                    "tokens",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
              "stale": {
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "tokens": {
                "type": "number",
              },
              "unknown": {
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
            },
            "required": [
              "snippets",
              "tokens",
              "naiveTokens",
              "savedTokens",
              "omitted",
              "stale",
              "unknown",
            ],
            "type": "object",
          },
          {
            "type": "null",
          },
        ],
      },
      "error": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "no_root",
                  "invalid_input",
                  "not_found",
                  "failed",
                ],
                "type": "string",
              },
              "message": {
                "type": "string",
              },
              "path": {
                "type": "string",
              },
            },
            "required": [
              "kind",
              "message",
            ],
            "type": "object",
          },
          {
            "type": "null",
          },
        ],
      },
      "meta": {
        "additionalProperties": false,
