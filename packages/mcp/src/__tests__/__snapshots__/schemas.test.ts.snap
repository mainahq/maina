exports[`tool schemas match the snapshot: verify 1`] = `
{
  "annotations": {
    "readOnlyHint": true,
  },
  "description": "Run the verification pipeline (syntax guard, deterministic tools, diff-only filter) on the working tree or explicit files. Returns passed/failed/skipped (never passed on an empty scope), the files checked, findings on changed lines, and each tool's status with the reason any tool was skipped.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "base": {
        "description": "Base ref for the diff-only filter. Defaults to the repo's base branch.",
        "type": "string",
      },
      "files": {
        "description": "Files to verify: repo-relative, or absolute inside the root. Omit to verify the working tree (staged, unstaged and untracked changes vs the base); an empty list verifies nothing.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "root": {
        "description": "Absolute path of the repository to act on. Defaults to the root the server resolves for itself, normally the repository it was started in.",
        "type": "string",
      },
    },
    "type": "object",
  },
  "name": "verify",
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "data": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "durationMs": {
                "type": "number",
              },
              "findings": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "column": {
                      "type": "number",
                    },
                    "file": {
                      "type": "string",
                    },
                    "line": {
                      "type": "number",
                    },
                    "message": {
                      "type": "string",
                    },
                    "ruleId": {
                      "type": "string",
                    },
                    "severity": {
                      "enum": [
                        "error",
                        "warning",
                        "info",
                      ],
                      "type": "string",
                    },
                    "tool": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "tool",
                    "file",
                    "line",
                    "message",
                    "severity",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
              "hiddenCount": {
                "type": "number",
              },
              "passed": {
                "type": "boolean",
              },
              "scope": {
                "additionalProperties": false,
                "properties": {
                  "files": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "kind": {
                    "enum": [
                      "working-tree",
                      "staged",
                      "range",
                      "files",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "kind",
                  "files",
                ],
                "type": "object",
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                ],
                "type": "string",
              },
              "syntaxErrors": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "column": {
                      "type": "number",
                    },
                    "file": {
                      "type": "string",
                    },
                    "line": {
                      "type": "number",
                    },
                    "message": {
                      "type": "string",
                    },
                    "severity": {
                      "enum": [
                        "error",
                        "warning",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "file",
                    "line",
                    "column",
                    "message",
                    "severity",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
              "syntaxPassed": {
                "type": "boolean",
              },
              "tools": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "durationMs": {
                      "type": "number",
                    },
                    "findings": {
                      "type": "number",
                    },
                    "reason": {
                      "type": "string",
                    },
                    "status": {
                      "enum": [
                        "passed",
                        "failed",
                        "skipped",
                      ],
                      "type": "string",
                    },
                    "tool": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "tool",
                    "status",
                    "findings",
                    "durationMs",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
            },
            "required": [
              "status",
              "passed",
              "scope",
              "syntaxPassed",
              "findings",
              "hiddenCount",
              "tools",
              "durationMs",
            ],
            "type": "object",
          },
          {
            "type": "null",
          },
        ],
      },
      "error": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "no_root",
                  "invalid_input",
                  "not_found",
                  "failed",
                ],
                "type": "string",
              },
              "message": {
                "type": "string",
              },
              "path": {
                "type": "string",
              },
            },
            "required": [
              "kind",
              "message",
            ],
            "type": "object",
          },
          {
            "type": "null",
          },
        ],
      },
      "meta": {
        "additionalProperties": false,
        "properties": {
          "durationMs": {
            "type": "number",
          },
          "root": {
            "anyOf": [
              {
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "tool": {
            "type": "string",
          },
          "version": {
            "type": "string",
          },
        },
        "required": [
          "tool",
          "root",
          "version",
          "durationMs",
        ],
        "type": "object",
      },
    },
    "required": [
      "data",
      "error",
      "meta",
    ],
    "type": "object",
  },
}
`;

exports[`tool schemas match the snapshot: decide 1`] = `
{
  "annotations": {
    "readOnlyHint": true,
  },
  "description": "Answer typed questions for a decision type (e.g. finding.real, diff.needs_review) with the repo's policy. Each answer comes with a probability distribution and the backend that produced it.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "questions": {
        "description": "The questions to answer: choice, score or bool.",
        "items": {
          "oneOf": [
            {
              "properties": {
                "id": {
                  "type": "string",
                },
                "kind": {
                  "const": "choice",
                  "type": "string",
                },
                "options": {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              },
              "required": [
                "kind",
                "id",
                "options",
              ],
              "type": "object",
            },
            {
              "properties": {
                "id": {
                  "type": "string",
                },
                "kind": {
                  "const": "score",
                  "type": "string",
                },
                "max": {
                  "type": "number",
                },
                "min": {
                  "type": "number",
                },
              },
              "required": [
                "kind",
                "id",
                "min",
                "max",
              ],
              "type": "object",
            },
            {
              "properties": {
                "id": {
                  "type": "string",
                },
                "kind": {
                  "const": "bool",
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "id",
              ],
              "type": "object",
            },
          ],
        },
        "type": "array",
      },
      "root": {
        "description": "Absolute path of the repository to act on. Defaults to the root the server resolves for itself, normally the repository it was started in.",
        "type": "string",
      },
      "state": {
        "description": "What the decision is made over: \`trusted\` holds computed or configured values, \`untrusted\` repository or agent content (never treated as instructions).",
        "properties": {
          "trusted": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string",
            },
            "type": "object",
          },
          "untrusted": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string",
            },
            "type": "object",
          },
        },
        "required": [
          "trusted",
          "untrusted",
        ],
        "type": "object",
      },
      "type": {
        "description": "The decision type, e.g. finding.real.",
        "type": "string",
      },
    },
    "required": [
      "type",
      "questions",
    ],
    "type": "object",
  },
  "name": "decide",
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "data": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "decisions": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "answer": {
                      "anyOf": [
                        {
                          "type": "string",
                        },
                        {
                          "type": "number",
                        },
                        {
                          "type": "boolean",
                        },
                      ],
                    },
                    "backend": {
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                        },
                        "version": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                        "version",
                      ],
                      "type": "object",
                    },
                    "confidence": {
                      "type": "number",
                    },
                    "distribution": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "answer": {
                            "anyOf": [
                              {
                                "type": "string",
                              },
                              {
                                "type": "number",
                              },
                              {
                                "type": "boolean",
                              },
                            ],
                          },
                          "p": {
                            "type": "number",
                          },
                        },
                        "required": [
                          "answer",
                          "p",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "id": {
                      "type": "string",
                    },
                    "latencyMs": {
                      "type": "number",
                    },
                    "type": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "type",
                    "answer",
                    "distribution",
                    "confidence",
                    "backend",
                    "latencyMs",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
            },
            "required": [
              "decisions",
            ],
            "type": "object",
          },
          {
            "type": "null",
          },
        ],
      },
      "error": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "no_root",
                  "invalid_input",
                  "not_found",
                  "failed",
                ],
                "type": "string",
              },
              "message": {
                "type": "string",
              },
              "path": {
                "type": "string",
              },
            },
            "required": [
              "kind",
              "message",
            ],
            "type": "object",
          },
          {
            "type": "null",
          },
        ],
      },
      "meta": {
        "additionalProperties": false,
        "properties": {
          "durationMs": {
            "type": "number",
          },
          "root": {
            "anyOf": [
              {
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "tool": {
            "type": "string",
          },
          "version": {
            "type": "string",
          },
        },
        "required": [
          "tool",
          "root",
          "version",
          "durationMs",
        ],
        "type": "object",
      },
    },
    "required": [
      "data",
      "error",
      "meta",
    ],
    "type": "object",
  },
}
`;

