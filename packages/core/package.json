{
  "name": "@mainahq/core",
  "version": "1.8.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Maina core engines — Context, Prompt, and Verify for verification-first development",
  "homepage": "https://mainahq.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mainahq/maina.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "keywords": [
    "maina",
    "verification",
    "context-engine",
    "prompt-engine",
    "ai-code-review"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p bench",
    "bench": "bun bench/graph.bench.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.50",
    "@orama/orama": "^3.1.18",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "ai": "^6.0.145",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.5.0"
  }
}
