{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"required": ["api_key", "password"],
	"properties": {
		"api_key": { "type": "string", "description": "Your provider api_key" },
		"password": {
			"type": "string",
			"minLength": 8
		},
		"token": { "$ref": "#/definitions/token" },
		"secret": "string",
		"private_key": "",
		"auth_token": null
	},
	"examples": [{ "api_key": "<your-api-key>", "token": "${API_TOKEN}" }]
}
