{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://api.mainahq.com/link/v1/schemas/enrol-start-result.schema.json",
	"title": "EnrolStartResult",
	"description": "The device code to poll with and the user code a member approves. Maina Link protocol v1. Generated from src/link/protocol/**; do not edit (adr/0008).",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"v",
		"deviceCode",
		"userCode",
		"verificationUri",
		"expiresIn",
		"interval"
	],
	"properties": {
		"v": {
			"const": 1
		},
		"deviceCode": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]{32,128}$",
			"examples": [
				"dc_4f1b2c3d4e5f60718293a4b5c6d7e8f9"
			]
		},
		"userCode": {
			"type": "string",
			"pattern": "^[BCDFGHJKLMNPQRSTVWXZ]{4}-[BCDFGHJKLMNPQRSTVWXZ]{4}$",
			"examples": [
				"WDJB-MJHT"
			]
		},
		"verificationUri": {
			"type": "string",
			"pattern": "^https:\\/\\/[a-z0-9.-]+(:[0-9]{2,5})?(\\/[A-Za-z0-9._~/-]*)?$",
			"examples": [
				"https://app.mainahq.com/enrol"
			]
		},
		"expiresIn": {
			"type": "integer",
			"minimum": 1,
			"maximum": 600
		},
		"interval": {
			"type": "integer",
			"minimum": 1,
			"maximum": 60
		}
	}
}
