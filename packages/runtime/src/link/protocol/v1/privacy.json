{
	"v": 1,
	"description": "Every field a device sends over Maina Link, per data class (FR-PRIV-1, FR-PRIV-3). Generated from src/link/protocol/**; do not edit. `maina cloud privacy` prints the org's class from this file.",
	"dataClasses": {
		"metadata": "The default. Labels, numbers, ids and salted hashes only: no names, paths, commands, diffs or code.",
		"names": "Metadata plus repo and branch names, so the board shows them (org setting).",
		"rich": "Names plus command text, paths and diffs where an event type has them (Enterprise). The cloud envelope-encrypts them per org."
	},
	"salts": {
		"device": {
			"description": "The per-clone v1 decision-log salt (.maina/private/log-salt). Keys the decision record's hashes. Never leaves the machine.",
			"fields": [
				"decision:data.inputHash"
			]
		},
		"link": {
			"description": "The org link salt, delivered at enrolment (EnrolCompleteResult.linkSalt). Keys the repo and branch identifiers sent over Link (the fields below; v1 sends no path identifier) so an org's devices hash a repo alike. Held by the cloud and enrolled devices; never sent back.",
			"fields": [
				"run.started:data.repoHash",
				"run.started:data.branchHash"
			]
		}
	},
