{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://api.mainahq.com/link/v1/schemas/control-message.schema.json",
	"title": "ControlMessage",
	"description": "A signed instruction to one device: stop a run, grant its one revision, or rotate the org keys. Ed25519 by the org link-control key keyId over utf8(\"maina-cloud/sig/v1\\nlink-control\\n\" + orgId + \"\\n\") || JCS(message without sig). Maina Link protocol v1. Generated from src/link/protocol/**; do not edit (adr/0008).",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"v",
		"orgId",
		"messageId",
		"deviceId",
		"kind",
		"issuedAt",
		"expiresAt",
		"body",
		"keyId",
		"sig"
	],
	"properties": {
		"v": {
			"const": 1
		},
		"orgId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
			"examples": [
				"id_0001"
			]
		},
		"messageId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
			"examples": [
				"id_0001"
			]
		},
		"deviceId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
			"examples": [
				"id_0001"
			]
		},
		"kind": {
			"type": "string",
			"enum": [
				"stop",
				"revision_grant",
				"key_rotation"
			]
		},
		"issuedAt": {
			"type": "string",
			"pattern": "^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-9]))T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
			"examples": [
				"2026-09-01T10:00:00.000Z"
			]
		},
		"expiresAt": {
			"type": "string",
			"pattern": "^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-9]))T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
			"examples": [
				"2026-09-01T10:00:00.000Z"
			]
		},
		"body": {
			"type": "object",
			"description": "The kind's body (`$defs`)."
		},
		"keyId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
			"examples": [
				"id_0001"
			]
		},
		"sig": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
			"examples": [
				"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
			]
		}
	},
	"$defs": {
		"stop": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"runId"
			],
			"properties": {
				"runId": {
					"type": "string",
					"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
					"examples": [
						"id_0001"
					]
				},
				"reason": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9_.-]{0,63}$",
					"examples": [
						"claude-code"
					]
				}
			}
		},
		"revision_grant": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"runId",
				"grantId"
			],
			"properties": {
				"runId": {
					"type": "string",
					"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
					"examples": [
						"id_0001"
					]
				},
				"grantId": {
					"type": "string",
					"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
					"examples": [
						"id_0001"
					]
				}
			}
		},
		"key_rotation": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"add",
				"retire"
			],
			"properties": {
				"add": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"keyId",
							"purpose",
							"alg",
							"publicKey",
							"notBefore"
						],
						"properties": {
							"keyId": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
								"examples": [
									"id_0001"
								]
							},
							"purpose": {
								"type": "string",
								"enum": [
									"policy-bundle",
									"approval-resolution",
									"link-control"
								]
							},
							"alg": {
								"type": "string",
								"enum": [
									"ed25519"
								]
							},
							"publicKey": {
								"type": "string",
								"pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
								"examples": [
									"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo"
								]
							},
							"notBefore": {
								"type": "string",
								"pattern": "^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-9]))T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
								"examples": [
									"2026-09-01T10:00:00.000Z"
								]
							},
							"notAfter": {
								"type": "string",
								"pattern": "^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-9]))T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
								"examples": [
									"2026-09-01T10:00:00.000Z"
								]
							}
						}
					},
					"maxItems": 16
				},
				"retire": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
						"examples": [
							"id_0001"
						]
					},
					"maxItems": 16
				}
			}
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"kind": {
						"const": "stop"
					}
				},
				"required": [
					"kind"
				]
			},
			"then": {
				"properties": {
					"body": {
						"$ref": "#/$defs/stop"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"kind": {
						"const": "revision_grant"
					}
				},
				"required": [
					"kind"
				]
			},
			"then": {
				"properties": {
					"body": {
						"$ref": "#/$defs/revision_grant"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"kind": {
						"const": "key_rotation"
					}
				},
				"required": [
					"kind"
				]
			},
			"then": {
				"properties": {
					"body": {
						"$ref": "#/$defs/key_rotation"
					}
				}
			}
		}
	]
}
