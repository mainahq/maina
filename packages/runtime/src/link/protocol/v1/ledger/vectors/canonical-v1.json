{
	"description": "Ledger canonical form v1 (adr/0005): RFC 8785 (JCS) restricted to safe integers, with NFC-normalised strings and keys. `canonical` is the exact UTF-8 text that is hashed. Pinned by the offline ledger verifier (plan Task 13.5).",
	"version": 1,
	"accepts": [
		{
			"name": "keys sorted at every level",
			"input": { "b": 1, "a": 2, "c": { "z": null, "y": [3, 2, 1] } },
			"canonical": "{\"a\":2,\"b\":1,\"c\":{\"y\":[3,2,1],\"z\":null}}"
		},
		{
			"name": "literals and safe-integer bounds",
			"input": [true, false, null, 0, -1, 9007199254740991, -9007199254740991],
			"canonical": "[true,false,null,0,-1,9007199254740991,-9007199254740991]"
		},
		{
			"name": "negative zero is zero",
			"input": -0,
			"canonical": "0"
		},
		{
			"name": "an integral number literal is an integer",
			"input": 1.0,
			"canonical": "1"
		},
		{
			"name": "string escaping follows JSON.stringify (JCS)",
			"input": "\"\\/\b\f\n\r\t\u0001\u001f\u007f",
			"canonical": "\"\\\"\\\\/\\b\\f\\n\\r\\t\\u0001\\u001f\u007f\""
		},
		{
			"name": "non-ASCII is emitted as raw UTF-8",
			"input": "héllo €𝄞",
			"canonical": "\"héllo €𝄞\""
		},
		{
			"name": "string values are NFC-normalised",
			"input": "é",
			"canonical": "\"é\""
		},
		{
			"name": "keys are NFC-normalised",
			"input": { "é": 1 },
			"canonical": "{\"é\":1}"
		},
		{
			"name": "keys sort by UTF-16 code units (a surrogate pair sorts before U+E000)",
			"input": { "": 1, "😀": 2, "a": 3 },
			"canonical": "{\"a\":3,\"😀\":2,\"\":1}"
		},
		{
			"name": "empty containers",
			"input": { "b": [], "a": {} },
			"canonical": "{\"a\":{},\"b\":[]}"
		}
	],
	"rejects": [
		{ "name": "a float", "input": 1.5, "path": "$" },
		{ "name": "a small float", "input": 1e-7, "path": "$" },
		{ "name": "an overflowing number", "input": 1e400, "path": "$" },
		{ "name": "an unsafe integer", "input": 9007199254740992, "path": "$" },
		{ "name": "a nested float", "input": { "a": [{ "b": 0.1 }] }, "path": "$.a[0].b" },
		{ "name": "a lone surrogate", "input": "\ud800", "path": "$" },
		{ "name": "a lone surrogate in a key", "input": { "\udc00": 1 }, "path": "$" },
		{ "name": "keys that collide after NFC", "input": { "é": 1, "é": 2 }, "path": "$" }
	]
}
