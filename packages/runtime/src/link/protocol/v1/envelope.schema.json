{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://api.mainahq.com/link/v1/schemas/envelope.schema.json",
	"title": "LinkEnvelope",
	"description": "A signed, ordered batch of one device's events (POST /link/v1/events). Maina Link protocol v1. Generated from src/link/protocol/**; do not edit (adr/0008).",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"v",
		"deviceId",
		"seqFrom",
		"seqTo",
		"sentAt",
		"events",
		"sig"
	],
	"properties": {
		"v": {
			"const": 1
		},
		"deviceId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
			"examples": [
				"id_0001"
			]
		},
		"seqFrom": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"seqTo": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"sentAt": {
			"type": "string",
			"pattern": "^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-9]))T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
			"examples": [
				"2026-09-01T10:00:00.000Z"
			]
		},
		"events": {
			"type": "array",
			"minItems": 1,
			"maxItems": 1000,
			"description": "Strictly increasing seq; the first at seqFrom, the last at seqTo.",
			"items": {
				"$ref": "event.schema.json"
			}
		},
		"sig": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
			"examples": [
				"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
			],
			"description": "Ed25519 by the device key over utf8(\"maina-link/sig/v1\\nenvelope\\n\") || JCS(envelope without sig)."
		}
	}
}
