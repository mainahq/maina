{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://api.mainahq.com/link/v1/schemas/event.schema.json",
	"title": "LinkEvent",
	"description": "One runtime event. `data` is the schema for the event's `type` at its declared `dataClass` (see `$defs`); at `metadata` it holds only labels, numbers and salted hashes. Maina Link protocol v1. Generated from src/link/protocol/**; do not edit (adr/0008).",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"eventId",
		"seq",
		"ts",
		"type",
		"dataClass",
		"data"
	],
	"properties": {
		"eventId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
			"examples": [
				"id_0001"
			]
		},
		"seq": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"ts": {
			"type": "string",
			"pattern": "^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-9]))T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
			"examples": [
				"2026-09-01T10:00:00.000Z"
			]
		},
		"type": {
			"type": "string",
			"enum": [
				"decision",
				"approval.requested",
				"approval.resolved",
				"run.started",
				"run.step",
				"run.finished",
				"receipt",
				"spend",
				"inventory",
				"override"
			]
		},
		"dataClass": {
			"type": "string",
			"enum": [
				"metadata",
				"names",
				"rich"
			]
		},
		"runId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$",
			"examples": [
				"id_0001"
			]
		},
		"data": {
			"type": "object",
			"description": "The event's data: `$defs[<type>.<dataClass>]`, chosen by the allOf branches."
		}
	},
