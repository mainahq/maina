{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "claude-code.session-start.output",
  "description": "Claude Code SessionStart hook stdout JSON. Limited to documented, non-deprecated fields so adapters cannot emit keys the host ignores.",
  "x-source": {
    "url": "https://code.claude.com/docs/en/hooks#sessionstart-decision-control",
    "retrieved": "2026-09-25"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "continue": {
      "type": "boolean"
    },
    "stopReason": {
      "type": "string"
    },
    "suppressOutput": {
      "type": "boolean"
    },
    "systemMessage": {
      "type": "string"
    },
    "terminalSequence": {
      "type": "string"
    },
    "hookSpecificOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hookEventName"
      ],
      "properties": {
        "hookEventName": {
          "const": "SessionStart"
        },
        "additionalContext": {
          "type": "string"
        },
        "initialUserMessage": {
          "type": "string"
        },
        "sessionTitle": {
          "type": "string"
        },
        "watchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reloadSkills": {
          "type": "boolean"
        }
      }
    }
  }
}
