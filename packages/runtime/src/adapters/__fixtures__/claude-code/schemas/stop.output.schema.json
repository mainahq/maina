{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "claude-code.stop.output",
  "description": "Claude Code Stop hook stdout JSON. Limited to documented, non-deprecated fields so adapters cannot emit keys the host ignores.",
  "x-source": {
    "url": "https://code.claude.com/docs/en/hooks#stop-decision-control",
    "retrieved": "2026-09-25"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "continue": {
      "type": "boolean"
    },
    "stopReason": {
      "type": "string"
    },
    "suppressOutput": {
      "type": "boolean"
    },
    "systemMessage": {
      "type": "string"
    },
    "terminalSequence": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "block"
      ]
    },
    "reason": {
      "type": "string"
    },
    "hookSpecificOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hookEventName"
      ],
      "properties": {
        "hookEventName": {
          "const": "Stop"
        },
        "additionalContext": {
          "type": "string"
        }
      }
    }
  },
  "if": {
    "required": [
      "decision"
    ]
  },
  "then": {
    "required": [
      "reason"
    ]
  }
}
