{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "claude-code.session-start.input",
  "description": "Claude Code SessionStart hook stdin payload. Hosts add fields over time, so unknown properties are allowed.",
  "x-source": {
    "url": "https://code.claude.com/docs/en/hooks#sessionstart-input",
    "retrieved": "2026-09-25"
  },
  "type": "object",
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "source"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "permission_mode": {
      "enum": [
        "default",
        "plan",
        "acceptEdits",
        "auto",
        "dontAsk",
        "bypassPermissions"
      ]
    },
    "effort": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "hook_event_name": {
      "const": "SessionStart"
    },
    "source": {
      "enum": [
        "startup",
        "resume",
        "clear",
        "compact",
        "fork"
      ]
    },
    "model": {
      "type": "string"
    },
    "session_title": {
      "type": "string"
    },
    "seconds_since_last_response": {
      "type": "number"
    },
    "context_tokens": {
      "type": "integer"
    },
    "prompt_cache_likely_expired": {
      "type": "boolean"
    },
    "estimated_cache_write_usd": {
      "type": "number"
    }
  }
}
