        "verification",
        "guardrails",
        "code-review",
        "mcp",
        "tdd",
      ],
      "license": "Apache-2.0",
      "name": "maina",
      "repository": "https://github.com/mainahq/maina",
      "version": "1.8.1",
    },
  },
  "paths": [
    "plugin.json",
    "hooks/hooks.json",
    "mcp.json",
    "skills/gate/SKILL.md",
    "skills/verify/SKILL.md",
