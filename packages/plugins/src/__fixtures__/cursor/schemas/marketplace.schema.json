{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainahq.com/fixtures/cursor/marketplace.schema.json",
  "x-source": {
    "url": "https://cursor.com/docs/reference/plugins",
    "retrieved": "2026-09-26"
  },
  "title": "Cursor plugin marketplace (.cursor-plugin/marketplace.json)",
  "description": "A multi-plugin repository's listing, at `.cursor-plugin/marketplace.json` in the repo root. It is what a submission to the Cursor Marketplace points at and what a Team Marketplace (Dashboard, Plugins & MCPs, Add Marketplace, Import from Repo; https://cursor.com/docs/plugins) reads; Auto Refresh re-reads it on each push. A plugin entry's `source` is a path to the plugin directory, or an object with `path`.",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "properties": {
    "name": { "$ref": "#/$defs/kebab" },
    "owner": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "version": { "type": "string" },
        "pluginRoot": { "type": "string" }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "kebab": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "paths": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "plugin": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": { "$ref": "#/$defs/kebab" },
        "source": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "required": ["path"],
              "properties": { "path": { "type": "string", "minLength": 1 } }
            }
          ]
        },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "author": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "email": { "type": "string" }
          },
          "additionalProperties": false
        },
        "homepage": { "type": "string" },
        "repository": { "type": "string" },
        "license": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "logo": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "skills": { "$ref": "#/$defs/paths" },
        "rules": { "$ref": "#/$defs/paths" },
        "agents": { "$ref": "#/$defs/paths" },
        "commands": { "$ref": "#/$defs/paths" },
        "hooks": { "anyOf": [{ "type": "string" }, { "type": "object" }] },
        "mcpServers": {
          "anyOf": [
            { "type": "string" },
            { "type": "object" },
            { "type": "array" }
          ]
        },
        "variables": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
