{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/launcher/launch.sh hook --host codex SessionStart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|mcp__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/launcher/launch.sh hook --host codex PreToolUse"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(Bash|apply_patch|mcp__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/launcher/launch.sh hook --host codex PermissionRequest"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/launcher/launch.sh hook --host codex Stop"
          }
        ]
      }
    ]
  }
}
