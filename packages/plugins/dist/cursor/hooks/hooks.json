{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./launcher/launch.sh hook --host cursor sessionStart"
      }
    ],
    "preToolUse": [
      {
        "command": "./launcher/launch.sh hook --host cursor preToolUse",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./launcher/launch.sh hook --host cursor beforeShellExecution",
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "./launcher/launch.sh hook --host cursor beforeMCPExecution",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "./launcher/launch.sh hook --host cursor afterFileEdit"
      }
    ],
    "stop": [
      {
        "command": "./launcher/launch.sh hook --host cursor stop"
      }
    ]
  }
}
