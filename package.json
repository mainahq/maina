{
  "name": "maina",
  "version": "0.1.0",
  "homepage": "https://mainahq.com/",
  "workspaces": [
    "packages/cli",
    "packages/core",
    "packages/runtime",
    "packages/mcp",
    "packages/skills",
    "packages/docs"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run scripts/test-isolated.ts",
    "check": "bunx @biomejs/biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "verify": "bun run check && bun run typecheck && bun run test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "knip": "knip && knip --production --include files",
    "check:paths": "bun scripts/check-paths.ts",
    "docs:manifest": "bun scripts/docs-manifest.ts",
    "docs:check": "bun scripts/docs-manifest.ts --check",
    "e2e:onboarding": "bun ci/e2e/run-local.ts ts claude-code",
    "dogfood:receipt": "bun scripts/dogfood/receipt.ts",
    "dogfood:report": "bun scripts/dogfood/report.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "bun-types": "^1.3.12",
    "bunup": "^0.16.31",
    "knip": "^6.4.1",
    "lefthook": "^2.1.6",
    "typescript": "^5.8.3"
  }
}
