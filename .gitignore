node_modules/
dist/
# Host plugin packages are generated and committed: marketplaces install them.
!packages/plugins/dist/
*.tsbuildinfo
.DS_Store
.cursor/

# SQLite temp files
*.db-shm
*.db-wal

# Test artifacts
test-todos.db
test-todos.db-shm
test-todos.db-wal
todos.db
# Feedback test fixtures create timestamped temp dirs; never commit them.
packages/core/src/feedback/__tests__/tmp-capture-*

# Maina — local data (per-machine, not shared)
.maina/context/
.maina/cache/
.maina/feedback.db
.maina/feedback.db-shm
.maina/feedback.db-wal
.maina/stats.db
.maina/stats.db-shm
.maina/stats.db-wal
.maina/decisions.db
# Decision log salt (#422): per-repo secret, never shared
.maina/private/
# maina run receipts and permission logs (#320)
.maina/runs/
.maina/benchmarks/*.json
!.maina/benchmarks/stories/
.maina/wiki/.search-index.json
# Dogfood bootstrap (#286): per-machine decision log + local receipts
.maina/dogfood/log.jsonl
.maina/dogfood/receipts/

# Maina — shared files ARE tracked:
# .maina/constitution.md
# .maina/prompts/
# .maina/features/
# .maina/hooks/

# Astro build artifacts
packages/docs/dist/
packages/docs/.astro/

# Superpowers brainstorm sessions
.superpowers/
# Claude Code: local settings/worktrees stay private; the repo's shared
# settings.json (dogfood PreToolUse hook, #286) is tracked.
.claude/*
!.claude/settings.json

# Test-generated scratch directories and fixtures (wiki tmp dirs, language detect fixtures)
packages/**/__tests__/tmp-*/
packages/core/src/language/__tests__/__fixtures__/

# Private strategy docs — kept in mainahq/maina-cloud:strategy/ (see CLAUDE.md).
# Listed here so accidentally reviving these filenames won't leak them again.
PRODUCT_SPEC.md
IMPLEMENTATION_PLAN.md
MAINA_WIKI_*.md
maina-pitchdeck.pptx
*.pptx

# Bench fixtures (pinned third-party checkouts, see scripts/fixtures/)
.cache/
